{
  "info": {
    "name": "PenbunAPI v3.2.0",
    "description": "RESTful API for managing distribution and supply of books and stationery\n\n## Environment Variables\n- `base_url`: http://localhost:8089\n- `token`: (auto-set from Login request)\n\n## Usage\n1. Call \"Login\" to authenticate → token auto-saved\n2. All protected endpoints inherit the token via header\n3. Test each module's 8 CRUD functions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "opencode"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/public/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "public", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/public/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "public", "logout"]
            }
          }
        }
      ]
    },
