# คัดลอกเป็น .env แล้วเติมค่าที่ยังว่าง — .env ถูก gitignore ไว้ ห้าม commit
#
# สามตัวนี้ไม่มี default โดยเจตนา process จะไม่เริ่มทำงานถ้าไม่ได้ตั้ง
#   JWT_SECRET · DB_PASSWORD · CORS_ORIGINS
# ที่เหลือมี default อยู่แล้ว ใส่เฉพาะตอนต้องการค่าอื่น

# ── ฐานข้อมูล ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=PENBUN

# DB_TRUST_CERT=true ข้ามการตรวจใบรับรอง ใช้ได้เฉพาะฐานข้อมูลบนเครื่องตัวเอง
# บน production ต้องเป็น false ไม่งั้นรหัสผ่านวิ่งผ่านช่องที่ปลอมได้
DB_ENCRYPT=true
DB_TRUST_CERT=false

# ขนาด pool ตั้งไว้สำหรับ process เดียวที่อยู่ยาว
DB_MAX_OPEN=25
DB_MAX_IDLE=10
DB_CONN_MAX_LIFETIME=30m

# ── HTTP ─────────────────────────────────────────────────────────────────────
# PORT มาก่อน FIBER_PORT เสมอ — platform แบบคอนเทนเนอร์กำหนดพอร์ตผ่าน PORT
FIBER_PORT=8089

# คั่นด้วยจุลภาค ห้ามใส่ * เพราะ API ใช้ bearer token
#
# 4173 คือพอร์ตของ tools/serve.mjs ฝั่ง PenbunWeb (npm run dev) ไม่ใช่ 5173
# ซึ่งเป็นค่าของ Vite ที่โปรเจกต์นี้ไม่ได้ใช้ — ค่าที่ผิดจะดูเหมือนใช้งานได้
# จนกว่าจะมีคนเปิดหน้าเว็บจริง
#
# บน App Platform ต้องใส่โดเมนจริงของ PenbunWeb ทับค่านี้ และต้องตั้งไว้
# **ที่เดียว** เท่านั้น ตัวแปรระดับ component ทับระดับ app โดยหน้าจอไม่บอก
# ว่าค่าไหนชนะ ดูหัวข้อการนำขึ้นใช้งานใน README
CORS_ORIGINS=http://localhost:4173

HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=90s
HTTP_IDLE_TIMEOUT=60s
HTTP_BODY_LIMIT=20971520

# ── การยืนยันตัวตน ───────────────────────────────────────────────────────────
# สร้างด้วย: openssl rand -base64 48   (ต้องยาวอย่างน้อย 32 ตัวอักษร)
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
AUTH_MAX_FAIL=5

# เกิน 12 ทำให้ทุกการเข้าสู่ระบบช้าแบบทวีคูณ config จะปฏิเสธ
BCRYPT_COST=10
APPLOCK_WAIT_MS=10000

# ── ระบบ ─────────────────────────────────────────────────────────────────────
# production ปิดการพิมพ์ตารางเส้นทางตอนเริ่มทำงาน
APP_ENV=development
LOG_LEVEL=info
APP_VERSION=4.0.0
